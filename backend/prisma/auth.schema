generator client {
  provider = "prisma-client-js"
  output   = "../generated/auth"
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  nomeCompleto  String   @map("nome_completo") @db.VarChar(255)
  funcao        String   @default("usuario") @db.VarChar(50)
  telefone      String?  @db.VarChar(20)
  dataNascimento DateTime? @map("data_nascimento") @db.Date
  siglaEstado   String?  @map("sigla_estado") @db.VarChar(2)
  nomeCidade    String?  @map("nome_cidade") @db.VarChar(255)
  profissao     String?  @db.VarChar(255)
  cpf           String?  @db.VarChar(14)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("users")
}

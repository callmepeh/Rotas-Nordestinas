NEXT_PUBLIC_API_URL=https://rotas.example.com
AUTH_DATABASE_URL=postgresql://<identity-user>:<encoded-password>@<rds-endpoint>:5432/rotas_auth?schema=public&sslmode=require
CORE_DATABASE_URL=postgresql://<core-user>:<encoded-password>@<rds-endpoint>:5432/rotas_core?schema=public&sslmode=require
JWT_SECRET=<32-or-more-random-characters>
SERVICE_TOKEN=<random-internal-token>
